# Default backend is the offline mock stack.
# Set this to "dashscope" to use the DashScope-compatible Qwen API.
MLLMPROJECT_MODEL_BACKEND=mock

# DashScope / Qwen API settings.
MLLMPROJECT_DASHSCOPE_API_KEY=sk-d26e3f5e5a4d471a95a4eec8ed003f74
MLLMPROJECT_DASHSCOPE_CHAT_MODEL=qwen3.5-omni-flash
MLLMPROJECT_DASHSCOPE_VISION_MODEL=qwen3.5-omni-flash

# Optional local model settings.
MLLMPROJECT_USE_REAL_MODELS=0
MLLMPROJECT_QWEN3_MODEL_PATH=
MLLMPROJECT_EMBEDDING_MODEL_ID=BAAI/bge-m3
MLLMPROJECT_RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
MLLMPROJECT_VLM_MAX_NEW_TOKENS=512
MLLMPROJECT_VLM_MAX_IMAGES=1
